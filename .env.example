# ====================================================================
# AI HEALTH CLINIC - ENVIRONMENT CONFIGURATION
# ====================================================================

# Application Settings
APP_NAME="AI Health Clinic"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
SECRET_KEY=healthclinic-super-secure-jwt-key-change-in-production-2026-xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Set DB_ENGINE to "oracle" to connect to Oracle Database (Live SQL or local/cloud XE/Autonomous DB)
# When set to "sqlite", local SQLite database 'ai_health_clinic.db' is used for instant zero-dependency execution.
DB_ENGINE=sqlite
DB_FILE=ai_health_clinic.db

# Oracle Database Credentials (Required when DB_ENGINE=oracle)
ORACLE_USER=admin
ORACLE_PASSWORD=YourSecureOraclePassword123
ORACLE_DSN=localhost:1521/XEPDB1
# For Oracle Cloud Autonomous Database wallet:
ORACLE_CONFIG_DIR=
ORACLE_WALLET_LOCATION=

# AI Provider Configuration
# Supported providers: "gemini", "ollama", "local_rule_engine"
AI_PROVIDER=local_rule_engine
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=medllama2

# Storage paths
UPLOAD_DIR=backend/uploads
REPORTS_DIR=backend/uploads/reports
DOCTOR_DOCS_DIR=backend/uploads/doctor_docs
MAX_UPLOAD_SIZE_MB=15

# External Verification APIs (DigiLocker / NMC)
# Note: DigiLocker and NMC production APIs require government accreditation.
# Set to 'false' to use the fully verified manual review workflow.
DIGILOCKER_API_ENABLED=false
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
NMC_VERIFICATION_ENABLED=false

# External Pharmacy Connect Configuration
# External official landing links are verified. Live API integrations are marked unconfigured by default.
PHARMACY_LIVE_INTEGRATION_ENABLED=false
